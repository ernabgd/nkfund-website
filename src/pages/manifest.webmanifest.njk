---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ site.name_ka | dump | safe }},
  "short_name": {{ site.brand | dump | safe }},
  "description": {{ site.description_ka | dump | safe }},
  "lang": "ka",
  "start_url": {{ "/" | prefixUrl | dump | safe }},
  "scope": {{ "/" | prefixUrl | dump | safe }},
  "display": "browser",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": {{ "/assets/img/icons/icon-192.png" | prefixUrl | dump | safe }}, "sizes": "192x192", "type": "image/png" },
    { "src": {{ "/assets/img/icons/icon-512.png" | prefixUrl | dump | safe }}, "sizes": "512x512", "type": "image/png" },
    { "src": {{ "/assets/img/icons/icon-maskable-512.png" | prefixUrl | dump | safe }}, "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": {{ "/assets/img/icons/favicon.svg" | prefixUrl | dump | safe }}, "sizes": "any", "type": "image/svg+xml" }
  ]
}
